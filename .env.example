# Copiar a .env y completar. .env nunca se sube al repo.
# Orden de fallback de proveedores
PROVEEDORES=gemini,groq,ollama

# Gemini, gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq, gratis: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Local, sin clave
OLLAMA_MODEL=gemma4:e4b
OLLAMA_URL=http://localhost:11434/v1

# Para más adelante (pago)
ANTHROPIC_API_KEY=

# Router de intención (L05): orden de proveedores y modelo opcional por proveedor.
# Si un ROUTER_*_MODEL queda vacío, el router usa el mismo modelo que el agente.
PROVEEDORES_ROUTER=groq,gemini,ollama
ROUTER_GROQ_MODEL=
ROUTER_GEMINI_MODEL=
