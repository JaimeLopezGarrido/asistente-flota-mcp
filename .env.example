# Copiar a .env y completar. .env nunca se sube al repo.
# Orden de fallback de proveedores
PROVEEDORES=gemini,groq,ollama

# Gemini, gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq, gratis: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Local, sin clave
OLLAMA_MODEL=gemma4:e4b
OLLAMA_URL=http://localhost:11434/v1

# Para más adelante (pago)
ANTHROPIC_API_KEY=

# Router de intención (L05): orden de proveedores y modelo opcional por proveedor.
# Si un ROUTER_*_MODEL queda vacío, el router usa el mismo modelo que el agente.
PROVEEDORES_ROUTER=groq,gemini,ollama
ROUTER_GROQ_MODEL=
ROUTER_GEMINI_MODEL=

# API web (E1). Orígenes (esquema + dominio + puerto) que pueden llamar a la API desde el navegador,
# separados por coma. Nunca uses * en la demo pública.
ORIGENES_CORS=http://localhost:5500,http://127.0.0.1:5500
MAX_MENSAJES_POR_SESION=20
MAX_PEDIDOS_POR_MINUTO=10
MAX_SESIONES=500
MAX_HISTORIAL=20

# E2 a E4: RAG y demo pública
EMBEDDINGS_MODEL=gemini-embedding-001
GROQ_MODEL_GRANDE=openai/gpt-oss-120b
# En la demo de Vercel: PROVEEDORES=groq,groq_grande,gemini
